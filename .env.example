# Supabase project settings
# Copy this file to ".env" and fill in real values from your Supabase project dashboard
# (Project Settings > API). Never commit the real ".env" file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Design feedback: skip AuthGate and open patient mock UI (nav-only).
# Use false for the normal Auth → role shell path.
DESIGN_PREVIEW=false

# Debug API Console (Phase 6 QA): log Edge request/response/metrics in-app.
# Requires a non-release build. Ignored / forbidden in release (see doc/debug-mode-design.md).
DEBUG_API_CONSOLE=false

# Firebase / FCM (WBS 4.6a): Android uses android/app/google-services.json (gitignored).
# Server send uses Edge secret FIREBASE_SERVICE_ACCOUNT_JSON only — never put the
# service-account private key in this client .env file.

# Environmental intelligence APIs — prefer Edge Function secrets in production.
# Local .env is for development only. Never commit real keys.
AIRNOW_API_KEY=YOUR_AIRNOW_API_KEY
PURPLEAIR_READ_KEY=YOUR_PURPLEAIR_READ_KEY
# Google Maps Platform key with Pollen API enabled. Prefer Edge Function secrets in production.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# Contact email required in the NWS API User-Agent header. Never hardcode in source.
NWS_USER_AGENT_CONTACT=contact@howseasthma.com

# Email sending via Resend (https://resend.com/docs) — prefer Edge Function secrets.
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Read via env/secrets only; do not hardcode in Dart/TS source.
RESEND_FROM_EMAIL=noreply@howseasthma.com
RESEND_REPLY_TO=contact@howseasthma.com
TEST_EMAIL_RECIPIENT=YOUR_TEST_EMAIL
# e-Fax provider TBD — keep false until a provider is selected. No mock fax "SENT".
EFAX_ENABLED=false
