# Supabase project settings
# Copy this file to ".env" and fill in real values from your Supabase project dashboard
# (Project Settings > API). Never commit the real ".env" file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Design feedback: skip AuthGate and open patient mock UI (nav-only).
# Set false (or remove) to use the normal Auth → HomeShell path.
DESIGN_PREVIEW=true

# Environmental intelligence APIs (see doc/env-api-integration.md)
# Prefer storing these as Supabase Edge Function secrets for production;
# local .env is for development only. Never commit real keys.
AIRNOW_API_KEY=YOUR_AIRNOW_API_KEY
PURPLEAIR_READ_KEY=YOUR_PURPLEAIR_READ_KEY
# Google Maps Platform key with Pollen API enabled (PAT-08). Prefer Edge Function secrets in production.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
# Contact email required in the NWS API User-Agent header (see doc/env-api-integration.md 2.1.1).
# Confirmed 2026-07-25: contact@howseasthma.com (domain catch-all). Never hardcode in source.
NWS_USER_AGENT_CONTACT=contact@howseasthma.com

# Email sending (see doc/requirements.md, doc/screen-ux-decisions.md UX-Q2/Q3)
# Resend API (https://resend.com/docs) — Prefer Edge Function secrets in production.
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Confirmed 2026-07-25 (UX-Q2) — read via env/secrets only; do not hardcode in Dart/TS source.
RESEND_FROM_EMAIL=noreply@howseasthma.com
RESEND_REPLY_TO=contact@howseasthma.com
# Personal email for manual/dev testing (e.g. Resend test sends)
TEST_EMAIL_RECIPIENT=YOUR_TEST_EMAIL
# e-Fax provider TBD — keep false until a provider is selected (UX-Q3). No mock fax "SENT".
EFAX_ENABLED=false
